{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "programmernomad/laracorekit-site",
    "type": "project",
    "description": "Documentation and demo host for the LaraCoreKit Composer package.",
    "keywords": [
        "laravel",
        "filament",
        "laracorekit",
        "starter-kit"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "bezhansalleh/filament-language-switch": "^5.0",
        "erusev/parsedown": "^1.8",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^2.10|^3.0",
        "livewire/livewire": "^4.0",
        "programmernomad/laracorekit-demo-module": "^1.0",
        "spatie/laravel-medialibrary": "^11.17",
        "spatie/laravel-permission": "^6.23",
        "programmernomad/laracorekit": "dev-main"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\UIShowcase\\": "modules/UIShowcase/src/",
            "Modules\\Docs\\": "modules/Docs/src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "test": [
            "@php artisan test"
        ],
        "pint": [
            "vendor/bin/pint"
        ],
        "pint-test": [
            "vendor/bin/pint --test"
        ],
        "phpstan": [
            "vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "review": [
            "@pint-test",
            "@phpstan",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "packages/core",
            "options": {
                "symlink": true,
                "versions": {
                    "programmernomad/laracorekit": "dev-main"
                }
            }
        }
    ]
}
